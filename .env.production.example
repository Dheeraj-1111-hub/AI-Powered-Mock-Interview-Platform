# HIREIQ PRODUCTION ENVIRONMENT
NODE_ENV=production
PORT=4000
CLIENT_URL=https://hireiq.ai

# DATABASE
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/hireiq?retryWrites=true&w=majority

# SECURITY
JWT_SECRET=GENERATED_SECURE_RANDOM_STRING
COOKIE_SECRET=ANOTHER_SECURE_STRING

# AI SERVICES
AI_SERVICE_URL=http://ai-service:8000/api
GROQ_API_KEY=YOUR_PROD_GROQ_KEY

# INFRASTRUCTURE
JUDGE0_URL=https://api.judge0.com
REDIS_URL=redis://localhost:6379
