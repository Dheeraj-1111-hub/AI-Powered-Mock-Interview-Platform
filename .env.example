# Environment Variables for HireIQ AI Platform
# Copy this file to .env and fill in your actual values

# AI Service Configuration
GROQ_API_KEY=your-groq-api-key-here

# Code Execution Service (Local Judge0 - No key needed!)
# Make sure Judge0 is running: cd judge0 && docker compose up
JUDGE0_URL=http://localhost:2358

# Database Configuration (for local development)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hireiq

# JWT Secret (change this in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS Origin
CORS_ORIGIN=http://localhost:5174